# ────────────────────────────────────────────────────────────
#  knot.e 환경설정  —  cp .env.example .env  후 값 채우기
# ────────────────────────────────────────────────────────────

# [필수] Claude API 키 — knot.e의 판단 엔진
#   발급: https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=sk-ant-...

# [선택] 판단에 쓸 모델 (기본: claude-sonnet-5)
#   더 깊은 분석이 필요하면 claude-opus-4-8, 더 저렴하게는 claude-haiku-4-5-20251001
KNOTE_MODEL=claude-sonnet-5

# [선택] 텔레그램 알림 (Phase 3)
#   봇 토큰: 텔레그램 @BotFather 에서 발급
#   챗 ID:  봇에게 아무 메시지나 보낸 뒤
#           https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [선택] 주가 데이터 소스 (기본: yfinance, 키 불필요)
#   나중에 Finnhub/Polygon 등으로 바꿀 때 사용
MARKET_DATA_PROVIDER=yfinance
FINNHUB_API_KEY=
